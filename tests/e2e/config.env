# Default cheap models for E2E (override via host env before running make e2e).
# Sourced by scripts/e2e-containers.sh; existing environment wins.

ANTHROPIC_MODEL=${ANTHROPIC_MODEL:-claude-haiku-5-5}
# Bedrock model IDs (not Anthropic API shorthand). Global inference profile for Haiku 5.5.
ANTHROPIC_BEDROCK_MODEL=${ANTHROPIC_BEDROCK_MODEL:-global.anthropic.claude-haiku-5-5}
GEMINI_MODEL=${GEMINI_MODEL:-gemini-2.5-pro}
OPENAI_MODEL=${OPENAI_MODEL:-gpt-6-luna}
AZURE_OPENAI_MODEL=${AZURE_OPENAI_MODEL:-gpt-6-luna}
AZURE_OPENAI_ENDPOINT=${AZURE_OPENAI_ENDPOINT:-https://ols-test.openai.azure.com/}
AZURE_OPENAI_API_VERSION=${AZURE_OPENAI_API_VERSION:-2025-04-01-preview}
